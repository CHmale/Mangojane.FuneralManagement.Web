@model Mangojane.FuneralManagement.Web.Models.Booking
@{
    ViewData["Title"] = "Booking Details";
    ViewData["PageHeading"] = "Booking Details";
    ViewData["PageSubheading"] = $"Reference {Model.BookingId} • Live from Mobile Client";
}

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card-custom p-4 h-100">
            <h6 class="text-muted text-uppercase fw-bold mb-3 small">Client & Deceased Information</h6>
            <p class="mb-1"><strong>Client:</strong> @Model.ClientName</p>
            <p class="mb-1"><strong>Phone:</strong> @Model.ClientPhone</p>
            <p class="mb-1"><strong>Deceased:</strong> @Model.DeceasedName</p>
            <p class="mb-1"><strong>SA ID Number:</strong> @Model.DeceasedIdNumber</p>
            <p class="mb-1"><strong>Pickup:</strong> @Model.PickupAddress</p>
            <p class="mb-0"><strong>Cemetery:</strong> @Model.CemeteryName</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card-custom p-4 h-100">
            <h6 class="text-muted text-uppercase fw-bold mb-3 small">Funeral Arrangement</h6>
            <p class="mb-1"><strong>Burial Date:</strong> @Model.BurialDate.ToString("dd MMMM yyyy")</p>
            <p class="mb-1"><strong>Package:</strong> @Model.PackageName</p>
            <p class="mb-1"><strong>Casket:</strong> @Model.CasketModel</p>
            <p class="mb-1"><strong>Status:</strong> <span class="badge bg-warning text-dark">@Model.Status</span></p>
            @if (Model.HearseAssigned != null)
            {
                <div class="mt-3 p-2 bg-light rounded border">
                    <strong class="text-success d-block"><i class="bi bi-check-circle"></i> Allocated Resources:</strong>
                    <small class="d-block">Hearse: @Model.HearseAssigned</small>
                    <small class="d-block">Driver: @Model.DriverAssigned</small>
                </div>
            }
        </div>
    </div>
</div>

<div class="d-flex gap-3">
    <form method="post" asp-action="Approve" asp-route-id="@Model.BookingId">
        <button type="submit" class="btn btn-success px-4 py-2">Approve Booking</button>
    </form>
    <form method="post" asp-action="Reject" asp-route-id="@Model.BookingId">
        <button type="submit" class="btn btn-danger px-4 py-2">Reject Booking</button>
    </form>
    <a href="@Url.Action("Allocate", "Bookings", new { id = Model.BookingId })" class="btn btn-dark px-4 py-2">Allocate Resources</a>
</div>