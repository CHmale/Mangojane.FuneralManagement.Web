@{
    ViewData["Title"] = "Payment Recorded";
    ViewData["PageHeading"] = "Payment Recorded";
    ViewData["PageSubheading"] = "Action confirmation";
}

<div class="card-custom p-5 text-center mx-auto" style="max-width: 600px; margin-top: 30px;">
    <div style="width: 70px; height: 70px; background-color: #2E7D32; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto;">
        <i class="bi bi-check-lg text-white fs-1"></i>
    </div>
    <h3 class="fw-bold mb-3">Payment Recorded</h3>
    <p class="text-muted mb-4">Premium payment information has been recorded successfully for policy @ViewBag.PolicyNumber.</p>
    <a href="@Url.Action("Index", "Policies")" class="btn btn-dark px-5 py-2">Continue</a>
</div>