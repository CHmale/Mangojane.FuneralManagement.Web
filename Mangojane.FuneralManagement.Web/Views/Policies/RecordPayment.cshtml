@model Mangojane.FuneralManagement.Web.Models.RecordPaymentViewModel
@{
    ViewData["Title"] = "Record Premium Payment";
    ViewData["PageHeading"] = "Record Premium Payment";
    ViewData["PageSubheading"] = $"Policy {Model.PolicyNumber} • {Model.ClientName}";
}

<div class="card-custom p-4" style="max-width: 600px;">
    <form method="post" asp-action="RecordPayment">
        <input type="hidden" asp-for="PolicyNumber" />
        <input type="hidden" asp-for="ClientName" />
        <div class="mb-3">
            <label class="form-label small fw-bold">Amount (R)</label>
            <input type="number" step="0.01" asp-for="Amount" class="form-control form-control-lg" required />
        </div>
        <div class="mb-3">
            <label class="form-label small fw-bold">Payment Date</label>
            <input type="date" asp-for="PaymentDate" class="form-control form-control-lg" required />
        </div>
        <div class="mb-3">
            <label class="form-label small fw-bold">Reference Number</label>
            <input type="text" asp-for="ReferenceNumber" class="form-control form-control-lg" required />
        </div>
        <div class="mb-4">
            <label class="form-label small fw-bold">Payment Method</label>
            <input type="text" asp-for="PaymentMethod" class="form-control form-control-lg" required />
        </div>
        <button type="submit" class="btn btn-dark px-4 py-2">Record Payment</button>
    </form>
</div>