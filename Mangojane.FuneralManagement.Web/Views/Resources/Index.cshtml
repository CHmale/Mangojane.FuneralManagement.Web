@model List<Mangojane.FuneralManagement.Web.Models.VehicleAsset>
@{
    ViewData["Title"] = "Resources & Fleet Management";
    ViewData["PageHeading"] = "Resources & Fleet Management";
    ViewData["PageSubheading"] = "Available hearses, limousines, and equipment for funeral allocation.";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card-custom p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold mb-0">Parlour Fleet & Logistics Assets</h5>
        <a href="@Url.Action("Create")" class="btn btn-dark btn-sm" style="background-color: var(--espresso-bronze);">
            <i class="bi bi-plus-lg me-1"></i> Add New Resource
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="text-muted text-uppercase small">
                <tr>
                    <th>ID</th>
                    <th>Registration</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var v in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@v.VehicleId</td>
                            <td>@v.RegistrationNumber</td>
                            <td><span class="badge bg-secondary">@v.VehicleType</span></td>
                            <td>@v.Description</td>
                            <td>
                                @if (v.OperationalStatus == "Available")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning">@v.OperationalStatus</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a href="@Url.Action("Edit", new { id = v.VehicleId })" class="btn btn-sm btn-outline-dark"><i class="bi bi-pencil"></i> Edit</a>
                                    <form method="post" asp-action="Delete" asp-route-id="@v.VehicleId" onsubmit="return confirm('Remove this vehicle asset?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No vehicles or equipment found. Click <strong>Add New Resource</strong> to register one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>