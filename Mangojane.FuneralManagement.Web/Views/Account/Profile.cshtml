@{
    ViewData["Title"] = "Staff Profile";
    ViewData["PageHeading"] = "Staff Profile";
    ViewData["PageSubheading"] = "Manage the currently signed-in Mangojane staff account.";
}

<div class="card-custom p-5" style="max-width: 600px;">
    <div class="d-flex align-items-center gap-3 mb-4">
        <i class="bi bi-person-badge fs-1" style="color: var(--espresso-bronze);"></i>
        <div>
            <h4 class="fw-bold mb-0">@User.Identity?.Name</h4>
            <span class="badge bg-dark mt-1">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
        </div>
    </div>

    <div class="mb-2"><strong>Email:</strong> @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
    <div class="mb-2"><strong>Branch:</strong> @User.FindFirst("Branch")?.Value</div>
    <div class="mb-4"><strong>Portal Access:</strong> Full Administrative, Triage, and Dispatch Privileges</div>

    <form method="post" asp-action="Logout">
        <button type="submit" class="btn btn-danger px-4 py-2 fw-semibold">
            <i class="bi bi-box-arrow-right me-1"></i> Log Out
        </button>
    </form>
</div>