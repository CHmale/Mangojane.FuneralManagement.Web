@{
    Layout = "_Layout";
    ViewData["Title"] = "Staff Login";
}

<div class="container-fluid p-0" style="min-height: 100vh;">
    <div class="row g-0" style="min-height: 100vh;">
        <!-- Left Brand Panel -->
        <div class="col-md-5 d-flex flex-column justify-content-between p-5" style="background-color: var(--obsidian-black); color: white;">
            <div>
                <div class="d-flex align-items-center mb-4">
                    <div style="width: 56px; height: 56px; border-radius: 50%; border: 2px solid var(--bright-gold); background: #000; display: flex; align-items: center; justify-content: center; margin-right: 15px; box-shadow: 0 0 15px rgba(197, 155, 39, 0.4);">
                        <i class="bi bi-shield-fill" style="color: var(--bright-gold); font-size: 26px;"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold" style="letter-spacing: 3px; color: var(--mangojane-gold);">MANGOJANE</h3>
                        <small style="letter-spacing: 2px; color: #9C948D;">FUNERAL PARLOUR</small>
                    </div>
                </div>
                <p class="fst-italic" style="color: #C0B7AE;">"Restoring hope and comforting souls"</p>
            </div>

            <div class="text-center py-4">
                <i class="bi bi-flower1" style="font-size: 70px; color: var(--bright-gold); opacity: 0.9;"></i>
                <div class="mt-3 text-muted small">With Dignity, Always</div>
            </div>

            <div>
                <div class="text-uppercase fw-semibold" style="letter-spacing: 1px; color: #8C847D; font-size: 0.8rem;">Staff & Admin Management Portal</div>
                <div style="font-size: 0.75rem; color: #6C645D;">Branches: Thabong (Welkom) & Wesselsbron</div>
            </div>
        </div>

        <!-- Right Form Panel -->
        <div class="col-md-7 d-flex align-items-center justify-content-center p-5" style="background-color: var(--warm-parchment);">
            <div style="max-width: 420px; width: 100%;">
                <h2 class="fw-bold mb-1">Welcome Back</h2>
                <p class="text-muted mb-4">Sign in to manage Mangojane funeral operations.</p>

                <form method="post" asp-action="Login">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Staff email address</label>
                        <input type="email" name="email" class="form-control form-control-lg bg-white" value="admin@mangojane.co.za" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-semibold">Password</label>
                        <input type="password" name="password" class="form-control form-control-lg bg-white" value="AdminPass2026!" required />
                    </div>
                    <button type="submit" class="btn btn-dark w-100 py-3 fw-bold" style="background-color: var(--obsidian-black);">
                        Sign In
                    </button>
                </form>

                <div class="mt-4 text-center">
                    <small class="text-muted">Live Connected to Supabase (Cape Town af-south-1)</small>
                </div>
            </div>
        </div>
    </div>
</div>