<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mangojane Funeral Parlour</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --obsidian-black: #181513;
            --espresso-bronze: #2B1F17;
            --mangojane-gold: #B7A87C;
            --bright-gold: #C59B27;
            --warm-parchment: #FAF7F2;
            --alabaster-white: #FFFFFF;
            --card-border: #E5E0D8;
        }

        body {
            background-color: var(--warm-parchment);
            color: var(--obsidian-black);
            font-family: 'Segoe UI', system-ui, sans-serif;
            margin: 0;
            padding: 0;
        }

        .sidebar {
            width: 250px;
            background-color: var(--obsidian-black);
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            padding: 24px 0;
            z-index: 1000;
        }

        .sidebar-brand {
            padding: 0 20px 24px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* SVG Crest Emblem */
        .crest-logo {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            border: 2px solid var(--bright-gold);
            background: #000000;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 10px rgba(197, 155, 39, 0.4);
        }

        .sidebar-nav {
            list-style: none;
            padding: 16px 12px;
            margin: 0;
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            color: #C0B7AE;
            text-decoration: none;
            border-radius: 8px;
            font-size: 0.92rem;
            margin-bottom: 4px;
            transition: all 0.2s;
        }

        .sidebar-nav a:hover {
            color: #FFFFFF;
            background-color: rgba(255, 255, 255, 0.06);
        }

        .sidebar-nav a.active {
            background-color: var(--espresso-bronze);
            color: var(--bright-gold);
            border-left: 4px solid var(--bright-gold);
            font-weight: 600;
        }

        .sidebar-nav i {
            margin-right: 12px;
            font-size: 1.1rem;
        }

        .main-wrapper {
            margin-left: 250px;
            padding: 30px 40px;
            min-height: 100vh;
        }

        .card-custom {
            background: var(--alabaster-white);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
        }

        .btn-mangojane {
            background-color: var(--espresso-bronze);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 600;
        }

        .btn-mangojane:hover {
            background-color: #1a120d;
            color: var(--bright-gold);
        }
    </style>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="sidebar">
            <div class="sidebar-brand d-flex align-items-center gap-3">
                <div class="crest-logo">
                    <i class="bi bi-shield-fill" style="color: var(--bright-gold); font-size: 20px;"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold" style="color: var(--mangojane-gold); letter-spacing: 1.5px;">MANGOJANE</h5>
                    <small style="color: #8C847D; font-size: 0.7rem; text-transform: uppercase;">Staff Admin Portal</small>
                </div>
            </div>
            <ul class="sidebar-nav">
                <li><a href="@Url.Action("Dashboard", "Home")" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"><i class="bi bi-grid-1x2"></i> Dashboard</a></li>
                <li><a href="@Url.Action("Index", "Bookings")" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" ? "active" : "")"><i class="bi bi-calendar2-check"></i> Bookings</a></li>
                <li><a href="@Url.Action("Index", "Resources")" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Resources" ? "active" : "")"><i class="bi bi-truck"></i> Resources & Fleet</a></li>
                <li><a href="@Url.Action("Index", "Policies")" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Policies" ? "active" : "")"><i class="bi bi-shield-check"></i> Policies & Payments</a></li>
                <li><a href="@Url.Action("DailySchedule", "Schedule")" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Schedule" ? "active" : "")"><i class="bi bi-file-earmark-pdf"></i> Daily Schedule (PDF)</a></li>
                <li><a href="@Url.Action("Profile", "Account")" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Account" ? "active" : "")"><i class="bi bi-person-gear"></i> Staff Profile</a></li>
            </ul>
        </div>
        <div class="main-wrapper">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">@ViewData["PageHeading"]</h2>
                    <p class="text-muted mb-0">@ViewData["PageSubheading"]</p>
                </div>
                <div class="d-flex align-items-center gap-2 bg-white px-3 py-2 rounded-3 border" style="border-color: var(--card-border);">
                    <div class="text-end">
                        <div class="fw-bold small">@User.Identity?.Name</div>
                        <small class="text-muted" style="font-size: 0.72rem;">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</small>
                    </div>
                    <i class="bi bi-person-circle fs-4" style="color: var(--espresso-bronze);"></i>
                </div>
            </div>
            @RenderBody()
        </div>
    }
    else
    {
        @RenderBody()
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>